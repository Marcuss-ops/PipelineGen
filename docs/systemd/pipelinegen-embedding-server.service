[Unit]
Description=PipelineGen Embedding Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=pierone
WorkingDirectory=/home/pierone/Pyt/Pipelinegen
ExecStartPre=/bin/bash -c 'fuser -k 8001/tcp 2>/dev/null || true'
ExecStart=/usr/bin/python3 -m scripts.services.embedding_server --port 8001
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=10
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/pierone/.local/bin

[Install]
WantedBy=multi-user.target
