[Unit]
Description=Google Accounting uvicorn server
After=network.target

[Service]
Type=simple
User=pierone
WorkingDirectory=/home/pierone/Pyt/Pipelinegen/google-accounting
ExecStartPre=/bin/bash -c 'fuser -k 8000/tcp 2>/dev/null || true'
ExecStart=/usr/bin/xvfb-run --server-args="-screen 0 1920x1080x24" /usr/bin/python3 /home/pierone/.local/bin/uvicorn main:app --host 127.0.0.1 --port 8000
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
