[Unit]
# PipelineGen — Go HTTP server + in-process pipeline worker.
#
# Replaces the implicit "long-running server" edge from before the
# Operational Readiness PR. The canonical binary is `pipelinegen`
# (compiled from cmd/server) and lives at /opt/pipelinegen/pipelinegen.
# Configuration at /etc/pipelinegen/config.yaml (mounted read-only).
# Tokens (VELOX_ADMIN_TOKEN, VELOX_WORKER_TOKEN) live in /etc/pipelinegen/
# pipelinegen.env with mode 0600 / owner root.
#
# Day-1 install checklist:
#   1. Place binary at /opt/pipelinegen/pipelinegen (mode 0755, owner root).
#   2. Create /etc/pipelinegen/ directory and put config.yaml + pipelinegen.env
#      there. `chmod 0600 /etc/pipelinegen/pipelinegen.env`,
#      `chown root:root /etc/pipelinegen/pipelinegen.env`.
#   3. `systemctl daemon-reload && systemctl enable --now pipelinegen.service`.
#   4. `systemctl status pipelinegen` to confirm the binary booted (it
#      happily fails fast on a malformed config — see Validate() in
#      internal/infrastructure/config/config.go).
#
# Operators that run a separate worker host can disable the in-process
# worker by overriding ExecStart to `--mode=server`, and start
# pipelinegen-worker.service on every auxiliary host.

Description=PipelineGen server (HTTP + scheduler + maintenance)

After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as the system user. If you need a dedicated unprivileged user,
# create it via `useradd --system --shell /usr/sbin/nologin pipelinegen`
# and chown the data directory accordingly.
User=root
Group=root

WorkingDirectory=/var/lib/pipelinegen

# Kill any stale process holding the canonical port (8080 by default,
# overridable via VELOX_PORT). The `|| true` keeps ExecStartPre from
# failing when nothing is on the port (`fuser` exits 1 in that case).
ExecStartPre=-/bin/bash -c 'fuser -k ${VELOX_PORT:-8080}/tcp 2>/dev/null || true'

# The canonical binary. Override --mode via drop-in if you split the
# server / worker across hosts (see docs/separated-deployment.md, Phase
# 5+ TODO).
ExecStart=/opt/pipelinegen/pipelinegen --mode all --config /etc/pipelinegen/config.yaml

# EnvironmentFile carries the auth tokens and VELOX_PORT override. The
# file must be mode 0600 / owner root. See scripts/rotate_token.sh for
# machine-managed rotation.
EnvironmentFile=/etc/pipelinegen/pipelinegen.env

# Standard systemd kill semantics: SIGTERM, then SIGKILL after 60s.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=60

# Auto-restart on failure. systemd throttles restarts after 5 in 60s
# to avoid crash loops.
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=5

# Hardening: deny privilege escalation; restrict write paths.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pipelinegen /data
# Allow config + secrets reads (default with ProtectSystem=strict).
# Tighten further by adding `ProtectKernelTunables=true` etc. — out of
# scope here, document per deployment.

[Install]
WantedBy=multi-user.target
