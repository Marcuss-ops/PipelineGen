{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["cells", "radical_warnings", "honest_limitations"],
  "properties": {
    "cells": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["product", "metric", "value", "evidence"],
        "properties": {
          "product": {"enum": ["chronon3d", "previous_pipeline", "remotion"]},
          "metric": {"type": "string", "minLength": 1},
          "value": {},
          "evidence": {"enum": ["EVIDENCED", "SOURCED", "ESTIMATED"]}
        },
        "additionalProperties": false
      }
    },
    "radical_warnings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
    "honest_limitations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
