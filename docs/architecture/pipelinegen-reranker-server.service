[Unit]
Description=PipelineGen Reranker Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=pierone
WorkingDirectory=/home/pierone/src/go-master/projects/Pyt/VeloxEditing/refactored
ExecStart=/usr/bin/python3 scripts/reranker_server.py --port 8091
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
Environment=RERANKER_MODEL=BAAI/bge-reranker-v2-m3
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/pierone/.local/bin

[Install]
WantedBy=multi-user.target
