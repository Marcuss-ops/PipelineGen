# ============================================
# Dependencies
# ============================================
vendor/
node_modules/
**/node_modules/
web-admin/node_modules/

# ============================================
# Logs and temp files
# ============================================
*.log
*.tmp
tmp/
logs/
**/__pycache__/

# ============================================
# Environment and Secrets
# ============================================
.env
.env.local
*.env.*
credentials.json
token.json
token_full.json

# Production config — never commit real credentials, folder IDs, or IPs
config.yaml
!config.example.yaml

# ============================================
# Binaries
# ============================================
# These patterns are anchored to the repo root with a leading '/'.
# Without the anchor, gitignore treats `worker` / `server` / `pipelinegen`
# as matching any PATH COMPONENT named that way — which would recursively
# exclude `cmd/worker/`, `cmd/server/`, etc., and all source files under
# them, including new *_test.go (the W1 batch surfaced this regression).
# Anchor it so only the root-level build artifact is ignored.
pipelinegen
/server
/admin
/worker
*.exe
*.dll
*.so

# ============================================
# Editors
# ============================================
.vscode/
.idea/

# ============================================
# Build artifacts
# ============================================
bin/
build/
coverage.out
coverage.html
*.test
web-admin/dist/

# ============================================
# Runtime output directories (test fixtures, worker downloads)
# ============================================
**/completed_videos/
**/worker_downloads/
**/script_assets/
**/test-results/

# ============================================
# Database
# ============================================
data/

# YouTube cookies for yt-dlp authentication (exported from browser)
# Refresh periodically when cookies expire
config/youtube_cookies.txt
*.db
*.db.sqlite
*.db.sqlite-wal
*.db.sqlite-shm

