# Environment / secrets
.env*
!.env.example

# Backups / log / temp scratch artefacts
*.bak*
*.log
*.tmp

# Databases + Python bytecode
*.sqlite*
**/__pycache__/

# Runtime scratch directories
data/
tmp/
scratch/
.cache/
profiles/

# Dependencies (preserve vendor/)
node_modules/
**/node_modules/
vendor/

# Anchored root-level build artefacts (PR1: leading '/' prevents cmd/ subtree false positives)
/admin
/server
/worker
/pipelinegen
/archcheck

# Editor / multi-root workspace configs (preserve)
.idea/
.vscode/

# Preserve canonical go multi-module workspaces
go.work*

# VIM swap files (preserve)
*.swp
