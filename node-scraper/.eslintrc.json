{
  "root": true,
  "env": {
    "es2022": true,
    "node": true,
    "browser": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-inner-declarations": "off"
  },
  "overrides": [
    {
      "files": ["test/**/*.js"],
      "env": {
        "node": true
      },
      "globals": {
        "test": "readonly",
        "it": "readonly",
        "describe": "readonly",
        "before": "readonly",
        "after": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly"
      }
    },
    {
      "files": ["bin/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "data/artlist-profile/",
    "coverage/",
    ".nyc_output/"
  ]
}
