# node-scraper/Dockerfile.scraper
#
# Companion image to the PipelineGen Go binary — runs the persistent
# Artlist scraper Node.js server. Built only when docker-compose's
# pipelinegen-artlist service is enabled.
#
# Stub shipped with the Operational Readiness PR to satisfy
# docker-compose build (the previous docker-compose.yml referenced
# this file but did not ship it, so `docker compose up --build`
# failed silently on the first run — see CHANGELOG operational
# readiness PR review must-fix #5).
#
# Image base: node:22-bookworm-slim — pinned to LTS Node 22 to
# match the codebase's package.json "engines.node" requirement.
# Working directory is /app; expose the canonical scraper port 9123
# per config.example.yaml `artlist_scraper_server_url` comment.

FROM node:22-bookworm-slim

# Install only what the scraper actually needs at runtime. Chromium
# dependencies (libgtk, libnss, fontconfig) come in via Google's
# `nodejs/node-chrome` runtime image instead — see Phase 6+ plan to
# decouple from Playwright's bundled Chromium. For now the operator
# runs the scraper against an external Playwright install.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the Node.js sources. node-scraper/ is the canonical home; the
# Go binary references these via cfg.External.NodeScraperDir.
COPY . /app/

# Install npm dependencies (package.json is the contract with the Go
# binary's `node artlist_search.js` call).
RUN npm install --omit=dev

# Canonical scraper port per config.example.yaml's
# `artlist_scraper_server_url` comment ("http://localhost:9123 when
# server is running").
EXPOSE 9123

# Default ARTLIST_PORT matches docs/images/GEMINI.md and
# config.example.yaml's `artlist_scraper_server_url` field comment.
ENV PORT=9123 \
    ARTLIST_PORT=9123 \
    PERSISTENT=1

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:${PORT}/health || exit 1

# Persistent scraper server (Level 3 caching per design docs).
# Operators that prefer the system Playwright/Chromium route override
# CMD to `["node", "artlist_search.js"]` (Level 2 ephemeral).
CMD ["node", "artlist_server.js"]
