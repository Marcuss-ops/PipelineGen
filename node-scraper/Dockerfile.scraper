# node-scraper/Dockerfile.scraper
#
# Companion image to the PipelineGen Go binary — runs the persistent
# Artlist scraper Node.js server. Built only when docker-compose's
# pipelinegen-artlist service is enabled.
#
# Stub shipped with the Operational Readiness PR to satisfy
# docker-compose build (the previous docker-compose.yml referenced
# this file but did not ship it, so `docker compose up --build`
# failed silently on the first run — see CHANGELOG operational
# readiness PR review must-fix #5).
#
# Image base: node:22-bookworm-slim — pinned to LTS Node 22 to
# match the codebase's package.json "engines.node" requirement.
# Working directory is /app; expose the canonical scraper port 9123
# per config.example.yaml `artlist_scraper_server_url` comment.
#
# Phase 7 (docker-compose-hardening, June 2026): drop root before
# CMD. The node:22-bookworm-slim base image ships a `node` user
# with UID/GID 1000; we re-use it (instead of creating a new
# `scraper` user) so the UID matches the Go-side `pipelinegen`
# user and bind-mount permissions are predictable across services.
# The 1000 UID is also the typical operator workstation UID.

FROM node:22-bookworm-slim

# Install runtime dependencies. `chromium` is the headless browser
# the scraper launches; Debian's package ships its own
# fontconfig/nss deps so we don't need a separate Playwright
# install layer. Phase 1 audit fix (PR ref fix/artlist-container-runtime):
# the previous Dockerfile relied on the host's Chromium / a
# separate BROWSER_WS container, which made the scraper fail on
# vanilla `docker compose up --build`. Future work (Phase 6+) may
# pivot to a remote browser via BROWSER_WS, but for now we ship
# chromium in the image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      chromium \
 && rm -rf /var/lib/apt/lists/*

# Prevent puppeteer from downloading Chromium — the runtime uses
# the apt-installed system Chromium at ${CHROME_EXECUTABLE}.
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    CHROME_EXECUTABLE=/usr/bin/chromium

# Install npm dependencies first to leverage Docker layer caching.
# package.json and package-lock.json are copied before the full source
# so that npm ci is only re-run when dependencies change.
# Phase 7: --chown=node:node so the installed packages are owned by
# the non-root user (the subsequent `USER node` directive then has
# read+write access without a world-writable chmod).
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy the Node.js sources. node-scraper/ is the canonical home; the
# Go binary references these via cfg.External.NodeScraperDir.
COPY --chown=node:node . /app/

# Canonical scraper port per config.example.yaml's
# `artlist_scraper_server_url` comment ("http://localhost:9123 when
# server is running").
EXPOSE 9123

# Default ARTLIST_PORT matches docs/images/GEMINI.md and
# config.example.yaml's `artlist_scraper_server_url` field comment.
ENV PORT=9123 \
    ARTLIST_PORT=9123 \
    PERSISTENT=1

# HEALTHCHECK probes /ready, which actively round-trips Chromium
# (browser.version() over CDP). Phase 1 audit fix (PR ref
# fix/artlist-container-runtime): keep /health as liveness and
# route the Docker HEALTHCHECK through /ready so chromium-not-yet-
# launched → 503 → unhealthy → no traffic until warm.
HEALTHCHECK --interval=15s --timeout=10s --start-period=20s --retries=5 \
  CMD curl -fsS http://127.0.0.1:${PORT}/ready || exit 1

# Phase 7: drop root before CMD. The node user owns /app via the
# --chown=node:node COPY flags above; WORKDIR is inherited as /app
# from the base image (no explicit WORKDIR override needed).
USER node

# Persistent scraper server (Level 3 caching per design docs).
# Operators that prefer the system Playwright/Chromium route override
# CMD to `["node", "artlist_search.js"]` (Level 2 ephemeral).
CMD ["node", "artlist_server.js"]
