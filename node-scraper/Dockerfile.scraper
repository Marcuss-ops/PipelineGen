# node-scraper/Dockerfile.scraper
#
# Companion image to the PipelineGen Go binary — runs the persistent
# Artlist scraper Node.js server. Built only when docker-compose's
# pipelinegen-artlist service is enabled.
#
# Stub shipped with the Operational Readiness PR to satisfy
# docker-compose build (the previous docker-compose.yml referenced
# this file but did not ship it, so `docker compose up --build`
# failed silently on the first run — see CHANGELOG operational
# readiness PR review must-fix #5).
#
# Image base: node:22-bookworm-slim — pinned to LTS Node 22 to
# match the codebase's package.json "engines.node" requirement.
# Working directory is /app; expose the canonical scraper port 9123
# per config.example.yaml `artlist_scraper_server_url` comment.

FROM node:22-bookworm-slim

# Install OS-level dependencies: ca-certificates + curl (for HEALTHCHECK),
# python3 + python3-pip (for scripts/bridges/*.py — sentence-transformers,
# spacy, yake, requests; see PR-FIX-PYTHON-BRIDGE-DEPS-2026-07-08),
# and Chromium + its headless dependencies (PR-FIX-SCRAPER-BROWSER, July 2026).
#
# Why Chromium-from-Debian instead of PUPPETEER_DOWNLOAD_HOST mirroring?
#   - `puppeteer-core ^25.2.0` is the runtime dep — we keep it
#     deliberately and run with PUPPETEER_SKIP_DOWNLOAD=true so npm ci
#     never fetches a binary. The OS-level Chromium installs from the
#     canonical Debian bookworm repository, so CI works without an
#     external proxy mirror.
#   - pickChromeExecutable() in node-scraper/src/driver/browser.js scans
#     /usr/bin/chromium first (after CHROME_EXECUTABLE override), so
#     this apt install lights up the local-binary fallback path
#     end-to-end without any PUPPETEER_* magic.
#   - Operators that prefer an external browser (Playwright-on-host,
#     Lightpanda, Chrome-WS service) override the path via
#     CHROME_EXECUTABLE=/path/to/their-binary or via BROWSER_WS /
#     LIGHTPANDA_WS / CHROME_WS env vars; the Debian Chromium layer
#     stays as the canonical fallback (godlike/07 fail-closed).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      python3 \
      python3-pip \
      chromium \
      chromium-driver \
      fonts-liberation \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libcups2 \
      libdbus-1-3 \
      libgbm1 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      libxshmfence1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Prevent puppeteer from downloading Chromium — the runtime uses
# an external browser via BROWSER_WS or CHROME_EXECUTABLE.
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Install Python bridge dependencies in a dedicated layer so Node source
# changes don't invalidate the pip install layer (~500MB+). The Python
# bridge scripts in /app/scripts/bridges/*.py (generate_embedding.py,
# index_clips.py, book_summarizer.py, etc.) require sentence-transformers
# (embeddings), spacy (NER + tokenization for search_text), yake[full]
# (keyword extraction), and requests (HTTP client). This bakes the
# previously-temporary `pip install ...` applied inside the live container
# at /app/ into the image permanently.
#
# --break-system-packages: required on Debian bookworm (PEP 668 enforces
# externally-managed Python environments; in-Docker builds opt out).
# --no-cache-dir: shrink the layer (no /root/.cache/pip).
RUN pip install --no-cache-dir --break-system-packages \
      sentence-transformers \
      spacy \
      "yake[full]" \
      requests

# Download the canonical English spacy model. The model is ~12MB and is
# cached in its own layer so the heavy pip install layer above is not
# invalidated by future spacy version bumps that ship a different model
# version under the same model name.
RUN python3 -m spacy download en_core_web_sm

# Install npm dependencies first to leverage Docker layer caching.
# package.json and package-lock.json are copied before the full source
# so that npm ci is only re-run when dependencies change.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy the Node.js sources. node-scraper/ is the canonical home; the
# Go binary references these via cfg.External.NodeScraperDir.
COPY . /app/

# Canonical scraper port per config.example.yaml's
# `artlist_scraper_server_url` comment ("http://localhost:9123 when
# server is running").
EXPOSE 9123

# Default ARTLIST_PORT matches docs/images/GEMINI.md and
# config.example.yaml's `artlist_scraper_server_url` field comment.
# P3 (July 2026): ARTLIST_SCRAPER_BIND defaults to '0.0.0.0' so the
# container is reachable from sibling services on the docker-compose
# `backend` bridge; the loopback default '127.0.0.1' made /health
# unreachable from pipelinegen-server. Operators that need a
# loopback-only scraper (unit tests, single-tenant dev) override
# ARTLIST_SCRAPER_BIND=127.0.0.1 in the deployable env file.
ENV PORT=9123 \
    ARTLIST_PORT=9123 \
    ARTLIST_SCRAPER_BIND=0.0.0.0 \
    PERSISTENT=1

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:${PORT}/health || exit 1

# Persistent scraper server (Level 3 caching per design docs).
# Discovery is handled by the direct GraphQL HTTP client; Chromium remains
# available only for detail/download fallback operations.
CMD ["node", "artlist_server.js"]
