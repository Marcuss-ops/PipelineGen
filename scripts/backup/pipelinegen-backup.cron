# PipelineGen nightly backup cron entry.
#
# Install (as root, or whichever user owns the PipelineGen data dir):
#   sudo crontab -e
#   # then paste the line below, tailored to your PGPATH / SRCDIR
#
# Cron semantics:
#   - "30 2 * * *" = every day at 02:30 local time. Pick a low-traffic hour.
#   - Logs to /var/log/pipelinegen-backup.log so you can monitor and alert.
#   - The script is idempotent and exits non-zero on failure, so you can
#     plug a downstream alerting rule:
#       tail -F /var/log/pipelinegen-backup.log | grep -i '\[error\|\[fatal' && alert
#
# Pre-requisites (covered by backup_pipelinegen.sh):
#   - sqlite3 CLI in PATH
#   - jq CLI in PATH
#   - curl in PATH
#   - Qdrant reachable at $QDRANT_URL (default http://127.0.0.1:6333)
#   - Read access to data/media.db.sqlite in $PROJECT_ROOT

# m h dom mon dow command
30 2 * * * SRCDIR=/home/pierone/Pyt/Pipelinegen BACKUP_ROOT=/var/backups/pipelinegen LOG_FILE=/var/log/pipelinegen-backup.log /bin/bash -c 'mkdir -p "$(dirname "$LOG_FILE")" && "$SRCDIR/scripts/backup/backup_pipelinegen.sh" >> "$LOG_FILE" 2>&1' >> /dev/null 2>&1
