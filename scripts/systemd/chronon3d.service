[Unit]
Description=Chronon3d warm Direct-YUV render daemon
After=local-fs.target
Before=pipelinegen.service
PartOf=pipelinegen.service

[Service]
Type=simple
User=pierone
WorkingDirectory=/home/pierone/src/go-master/projects/Pyt/VeloxEditing/Chronon3d
RuntimeDirectory=chronon3d
RuntimeDirectoryMode=0755
ExecStart=/home/pierone/src/go-master/projects/Pyt/VeloxEditing/Chronon3d/build/chronon/linux-video-fast-dev/apps/chronon3d_cli/chronon3d_cli daemon -s /run/chronon3d/chronon.sock -a /home/pierone/src/go-master/projects/Pyt/VeloxEditing/RenderingGen/testdata/golden --backend vulkan
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
