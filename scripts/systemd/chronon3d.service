[Unit]
Description=Chronon3d warm Direct-YUV render daemon
After=local-fs.target
Before=pipelinegen.service
PartOf=pipelinegen.service

[Service]
Type=simple
User=pierone
WorkingDirectory=/home/pierone/src/go-master/projects/Pyt/VeloxEditing/Chronon3d
RuntimeDirectory=chronon3d
RuntimeDirectoryMode=0755
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
# Use the validated local Chronon build with the available Vulkan GPU.
ExecStart=/home/pierone/src/go-master/projects/Pyt/VeloxEditing/Chronon3d/build/chronon/linux-video-fast-dev/apps/chronon3d_cli/chronon3d_cli daemon -s /run/chronon3d/chronon.sock -a /home/pierone/src/go-master/projects/Pyt/VeloxEditing/RenderingGen/testdata/golden --backend vulkan --gpu-device 0
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
