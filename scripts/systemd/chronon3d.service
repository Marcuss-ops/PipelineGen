[Unit]
Description=Chronon3d warm Direct-YUV render daemon
After=local-fs.target
Before=pipelinegen.service
# Deliberately NOT PartOf=pipelinegen.service: restarting PipelineGen must not
# tear down the warm Chronon daemon. The daemon's renderer, font cache, image
# cache and surface pools are process-persistent, and they are what makes clip
# N faster than clip 1. It still starts before PipelineGen at boot.

[Service]
Type=simple
User=@VELOX_USER@
WorkingDirectory=@VELOX_ROOT@/Chronon3d
RuntimeDirectory=chronon3d
RuntimeDirectoryMode=0755
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
# Use the validated local Chronon build with the available Vulkan GPU.
ExecStart=@VELOX_ROOT@/Chronon3d/build/chronon/linux-video-fast-dev/apps/chronon3d_cli/chronon3d_cli daemon -s /run/chronon3d/chronon.sock -a @VELOX_ROOT@/RenderingGen/testdata/golden --backend vulkan --gpu-device 0
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
