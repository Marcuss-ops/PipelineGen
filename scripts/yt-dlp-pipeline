#!/usr/bin/env bash
# PipelineGen yt-dlp wrapper.
#
# This wrapper is the canonical YTDLP_PATH for the pipelinegen systemd
# service. It fixes one runtime concern without owning YouTube policy:
#
#  JS runtime resolution: the systemd service runs with a restricted
#     PATH that does not include the node/nvm binary dir. yt-dlp's
#     --js-runtime node then cannot find the runtime and skips the player
#     (no formats -> "Requested format is not available"). This wrapper
#     prepends the node bin dir to PATH when node is not already resolvable,
#     so the default --js-runtime node keeps working in the service context.
#
# Resolve the real yt-dlp binary. The pip user install
# ($HOME/.local/bin/yt-dlp) carries the bgutil POT plugin and must win over
# the distro /usr/local/bin/yt-dlp that the restricted systemd PATH would
# otherwise resolve first.
#   - YTDLP_REAL_BIN env override, if set
#   - $HOME/.local/bin/yt-dlp (pip user install)
#   - `command -v yt-dlp` (last resort)
set -euo pipefail

REAL_BIN="${YTDLP_REAL_BIN:-}"
if [[ -z "$REAL_BIN" && -x "$HOME/.local/bin/yt-dlp" ]]; then
  REAL_BIN="$HOME/.local/bin/yt-dlp"
fi
if [[ -z "$REAL_BIN" ]]; then
  REAL_BIN="$(command -v yt-dlp 2>/dev/null || true)"
fi
if [[ -z "$REAL_BIN" || ! -x "$REAL_BIN" ]]; then
  echo "yt-dlp-pipeline: cannot locate the real yt-dlp binary" >&2
  exit 127
fi

# Prefer the nvm node (v22) used for the YouTube JS challenges. The distro
# /usr/bin/node (v20) that the service PATH resolves first fails to solve
# the player challenges, so yt-dlp is left without video formats. Prepend
# the nvm bin dir when it exists and is not already first on PATH.
NVM_NODE_DIR="$HOME/.nvm/versions/node/v22.22.2/bin"
if [[ -x "$NVM_NODE_DIR/node" && ":$PATH:" != *":$NVM_NODE_DIR:"* ]]; then
  export PATH="$NVM_NODE_DIR:$PATH"
fi

exec "$REAL_BIN" "$@"
