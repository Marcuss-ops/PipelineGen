#!/usr/bin/env bash
set -Eeuo pipefail

TOKEN_FILE="${TOKEN_FILE:-/etc/pipelinegen/pipelinegen.env}"

if [[ ! -r "$TOKEN_FILE" ]]; then
    echo "❌ Auth PipelineGen non disponibile."
    echo "File atteso: $TOKEN_FILE"
    echo "Verifica gruppo pipelinegen-agents e permessi 0640."
    exit 2
fi

# The canonical env file is authoritative even when the caller inherited an
# older VELOX_ADMIN_TOKEN. Keeping an inherited value here can authenticate
# the probe with one secret while the live service expects another, producing
# persistent and misleading 401 responses.
VELOX_ADMIN_TOKEN="$(
    sed -n 's/^VELOX_ADMIN_TOKEN=//p' "$TOKEN_FILE" |
    tail -n 1
)"
export VELOX_ADMIN_TOKEN

if [[ ! "$VELOX_ADMIN_TOKEN" =~ ^[a-fA-F0-9]{64}$ ]]; then
    echo "❌ VELOX_ADMIN_TOKEN assente o non valido."
    exit 2
fi

if [[ -z "${METRICS_AUTH_TOKEN:-}" && -r "$TOKEN_FILE" ]]; then
    METRICS_AUTH_TOKEN="$(
        sed -n 's/^METRICS_AUTH_TOKEN=//p' "$TOKEN_FILE" |
        tail -n 1
    )"
    export METRICS_AUTH_TOKEN
fi

# Master artifact credential. The remote Master signs artifact downloads with
# its OWN admin token, not with VELOX_ADMIN_TOKEN (a 401), and that file is not
# under $HOME when the caller runs from an agent profile directory. Resolve it
# once here, in the canonical order, and hand the PATH to velox download-final
# through VELOX_MASTER_TOKEN_FILE (the token itself is never printed).
if [[ -z "${VELOX_MASTER_TOKEN_FILE:-}" ]]; then
    for candidate in \
        /etc/pipelinegen/master.env \
        "${HOME:-}/creator-77-master.env" \
        /home/pierone/creator-77-master.env; do
        [[ -n "$candidate" && -r "$candidate" ]] || continue
        VELOX_MASTER_TOKEN_FILE="$candidate"
        export VELOX_MASTER_TOKEN_FILE
        break
    done
fi

exec "$@"
