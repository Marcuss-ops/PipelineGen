#!/usr/bin/env bash
set -Eeuo pipefail

TOKEN_FILE="${TOKEN_FILE:-/etc/pipelinegen/pipelinegen.env}"

if [[ ! -r "$TOKEN_FILE" ]]; then
    echo "❌ Auth PipelineGen non disponibile."
    echo "File atteso: $TOKEN_FILE"
    echo "Verifica gruppo pipelinegen-agents e permessi 0640."
    exit 2
fi

# The canonical env file is authoritative even when the caller inherited an
# older VELOX_ADMIN_TOKEN. Keeping an inherited value here can authenticate
# the probe with one secret while the live service expects another, producing
# persistent and misleading 401 responses.
VELOX_ADMIN_TOKEN="$(
    sed -n 's/^VELOX_ADMIN_TOKEN=//p' "$TOKEN_FILE" |
    tail -n 1
)"
export VELOX_ADMIN_TOKEN

if [[ ! "$VELOX_ADMIN_TOKEN" =~ ^[a-fA-F0-9]{64}$ ]]; then
    echo "❌ VELOX_ADMIN_TOKEN assente o non valido."
    exit 2
fi

if [[ -z "${METRICS_AUTH_TOKEN:-}" && -r "$TOKEN_FILE" ]]; then
    METRICS_AUTH_TOKEN="$(
        sed -n 's/^METRICS_AUTH_TOKEN=//p' "$TOKEN_FILE" |
        tail -n 1
    )"
    export METRICS_AUTH_TOKEN
fi

exec "$@"
