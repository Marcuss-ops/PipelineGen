#!/usr/bin/env bash
# scripts/hooks/pre-commit (godlike/06 SSOT canonical owner of pre-commit gating).
#
# FAIL-CLOSED pre-commit hook for the PipelineGen codebase. Blocks the
# git commit on any of the 3 gates:
#   (a) `go build ./<touched_pkg>/...` failure (catches orphan imports,
#       redeclarations, syntax errors, type errors).
#   (b) `go vet ./<touched_pkg>/...` failure (canonical static analysis).
#   (c) `_test.go` top-level funcs missing the `Test` prefix (Go testing
#       framework SKIPS these; silent coverage hole).
#
# SCOPE: scoped to TOUCHED packages only (`git diff --cached` derivation)
# so a commit touching 1 file costs ~1s of scan, NOT a full project
# build (godlike/07 minimum-blast-radius + AGENTS.md Git-Lesson).
#
# INSTALL: `make install-hooks` (or `git config core.hooksPath scripts/hooks`
# manually). Idempotent. Re-running is safe.
#
# BYPASS: `PIPELINEGEN_SKIP_PRECOMMIT=1 git commit ...` opt-out is
# available for emergency land-in (a known-broken commit that needs
# to ship before the fix); MUST be paired with a follow-up
# `fixup!: <subject>` commit + `git rebase --autosquash` once the fix
# is on main. Default-off; logged loudly so the bypass is not silent.
#
# MODES:
#   default    blocks commit on any failure (exit non-zero)
#   --dry-run  prints the would-be checks without blocking (exit 0)
#
# godlike/07 fail-closed at the GATE LEVEL: any non-zero exit code from
# any gate (a)/(b)/(c) aborts the commit. The single allowed
# exception is the staging derivation below, where each `grep -E`
# appends `|| true` so an unmatched filter on a non-Go-only commit
# (doc, scripts, markdown, yaml, test bash) returns rc=0 instead of
# propagating through `set -euo pipefail` and aborting a harmless
# doc-only commit. Canonical pattern (July 2026) — collect the gitops
# collective goal: a non-Go-only commit must exit pre-commit at the
# deliberate empty-stdout branch below, not on the bypass env.

set -euo pipefail

# ── Parse args + bypass env
DRY_RUN=0
if [ "${1:-}" = "--dry-run" ]; then
    DRY_RUN=1
fi

if [ "${PIPELINEGEN_SKIP_PRECOMMIT:-0}" = "1" ]; then
    echo "⚠️  PIPELINEGEN_SKIP_PRECOMMIT=1 — bypassing pre-commit gates."
    echo "    This MUST be paired with a follow-up fixup! commit + autosquash."
    exit 0
fi

# ── Resolve Go binary + working tree root
# AGENTS.md Git-Lesson: GO is overridable; respect Makefile convention.
GO="${GO:-go}"
if ! command -v "$GO" >/dev/null 2>&1; then
    # Fail-closed: missing Go toolchain breaks a commit; this matches
    # the existing go-version-check contract in Makefile.
    echo "❌ PIPELINEGEN PRECOMMIT: Go binary '$GO' not on PATH."
    echo "   Set GO environment variable or install Go in your shell env."
    exit 1
fi

# Move to repo root so `go build ./<pkg>/...` resolves the package path.
cd "$(git rev-parse --show-toplevel)"

# ── Determine touched packages (staged files only)
# Use --diff-filter=ACMR (Add / Change / Rename / Modify) so deletions
# don't trigger a scan against a no-longer-present file.
# File paths are repo-relative; convert to Go package paths by taking
# the directory of each file. For files at repo root, skip (build
# performance: ./... is fine but expensive on full diffs).
# Per-grep `|| true` per the header-comment exception: an unmatched
# filter must NOT propagate pipefail to the assignment; empty stdout
# is the explicit non-Go-only commit signal handled below.
TOUCHED_PKGS="$(git diff --cached --name-only --diff-filter=ACMR \
    | { grep -E '\.go$' || true; } \
    | { grep -E '^internal/|^pkg/|^cmd/' || true; } \
    | xargs -I{} dirname {} \
    | sort -u)"

TOUCHED_TEST_FILES="$(git diff --cached --name-only --diff-filter=ACMR \
    | { grep -E '_test\.go$' || true; })"

# ── Exit early if no Go-touching commit (e.g., doc-only commit)
if [ -z "$TOUCHED_PKGS" ] && [ -z "$TOUCHED_TEST_FILES" ]; then
    echo "✅ pre-commit: no Go files touched; skipping gate chain."
    exit 0
fi

echo "─────────────────────────────────────────────────────────────"
echo "PipelineGen pre-commit gate chain"
echo "  Touched packages:"
echo "$TOUCHED_PKGS" | sed 's/^/    /'
if [ -n "$TOUCHED_TEST_FILES" ]; then
    echo "  Touched _test.go files:"
    echo "$TOUCHED_TEST_FILES" | sed 's/^/    /'
fi
echo "─────────────────────────────────────────────────────────────"

if [ "$DRY_RUN" = "1" ]; then
    echo "(dry-run mode: would run gates, but not blocking)"
fi

GATE_FAILURES=0

# ── Gate (a)+(b): go build + go vet on touched packages
# Fail-loud if TOUCHED_PKGS leaks a file path — that signals a
# regression in the derivation above. See `git log -p scripts/hooks/pre-commit`
# for the historical failure mode that this guard was added to catch.
for pkg in $TOUCHED_PKGS; do
    case "$pkg" in
        *.go)
            echo "❌ GATE (a) pre-condition: TOUCHED_PKGS leaked file path '$pkg' — fix the derivation above."
            exit 1 ;;
        *) ;;  # directory path; proceed
    esac
    if [ "$DRY_RUN" = "1" ]; then
        echo "  [dry-run] would run: $GO build ./$pkg/..."
        echo "  [dry-run] would run: $GO vet ./$pkg/..."
        continue
    fi
    echo "→ go build ./$pkg/..."
    if ! "$GO" build "./$pkg/..." 2>&1; then
        echo "❌ GATE (a) FAILED: $GO build ./$pkg/..."
        GATE_FAILURES=$((GATE_FAILURES + 1))
    fi
    echo "→ go vet ./$pkg/..."
    if ! "$GO" vet "./$pkg/..." 2>&1; then
        echo "❌ GATE (b) FAILED: $GO vet ./$pkg/..."
        GATE_FAILURES=$((GATE_FAILURES + 1))
    fi
done

# Go's compiler and `go test` already validate test declarations. The old
# regex gate misclassified methods and legitimate helpers as tests, so it is
# intentionally removed rather than enforcing a false naming contract.

# ── Final report
echo "─────────────────────────────────────────────────────────────"
if [ "$GATE_FAILURES" -eq 0 ]; then
    echo "✅ pre-commit: all gates green. Proceeding with commit."
    exit 0
else
    echo "❌ pre-commit: $GATE_FAILURES gate(s) FAILED. Commit blocked."
    echo "   To bypass for emergency land-in: PIPELINEGEN_SKIP_PRECOMMIT=1 git commit ..."
    exit 1
fi
