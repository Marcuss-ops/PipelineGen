{
  "scenario_id": "01_text_only_cold",
  "description": "Vidrush text-only cold — benchmark puro del motore script. Solo script generation + entities, nessun provider media chiamato. Cache vuota (force_refresh: true).",
  "version": 1,
  "expect": {
    "http_status": 202,
    "terminal_status": "SUCCEEDED",
    "max_entities_per_segment": 5,
    "max_important_phrases_per_segment": 5,
    "max_important_words_per_segment": 5,
    "provider_requests_artlist": 0,
    "provider_requests_internet_images": 0,
    "cache_extraction": "MISS"
  },
  "payload": {
    "version": 2,
    "preset": "custom",
    "correlation_id": "vidrush-01-text-only-cold",
    "force_refresh": true,
    "items": [
      {
        "id": "vidrush-01-text-item",
        "title": "Vidrush text-only cold: benchmark puro motore script",
        "language": "en",
        "tone": "documentary",
        "style": "Write a concrete, grounded narrative. Do not invent details. Keep segments concise and distinct.",
        "model": "gemma4:e2b",
        "source": {
          "type": "text",
          "topic": "Three distinct visual stories for operational verification",
          "source_text": "A scientist examines a newly discovered fossil in a remote desert excavation site. The team carefully extracts the specimen while documenting every layer.\n\nA chef prepares a traditional dish in a busy open kitchen. Steam rises from the pan as fresh ingredients are added one by one.\n\nAn architect reviews blueprints at a construction site. Workers assemble steel beams while a crane lifts materials to the upper floors.\n\nOperational marker: vidrush-01-text-only-cold."
        },
        "script_params": {
          "target_words": 260,
          "min_words": 200,
          "segment_words": 60,
          "skip_quality_gate": true,
          "use_memory": true
        },
        "output": {
          "extract_entities": true,
          "generate_metadata": false,
          "save_to_db": true,
          "stock_enabled": "disabled"
        },
        "media_plan": {
          "mode": "hybrid",
          "provider_policy": {
            "artlist": "disabled",
            "internet_images": "disabled"
          },
          "extraction": {
            "enabled": false,
            "max_entities_per_segment": 5,
            "max_important_phrases_per_segment": 5,
            "max_important_words_per_segment": 5,
            "max_artlist_queries_per_segment": 0,
            "max_image_queries_per_segment": 0
          }
        }
      }
    ]
  },
  "assertions": {
    "dispatch": {
      "http_202": ".http_status == 202",
      "job_id_present": ".job_id != null and (.job_id | length) > 0",
      "status_url": ".status_url == \"/api/jobs/\" + .job_id + \"/full\"",
      "ok_true": ".ok == true"
    },
    "terminal": {
      "status_succeeded": ".status == \"completed\" or .status == \"SUCCEEDED\"",
      "has_current_stage": "(.current_stage | type) == \"string\" and (.current_stage | length) > 0"
    },
    "result": {
      "min_segments": 3,
      "segments": {
        "positions_ordered": "[.segments[].position] == ([.segments[].position] | sort)",
        "segment_ids_unique": "([.segments[].segment_id] | unique | length) == ([.segments[].segment_id] | length)",
        "per_segment": {
          "segment_id_non_empty": ".segment_id | length > 0",
          "text_non_empty": ".text | length > 0",
          "text_hash_non_empty": ".text_hash | length > 0",
          "entities_max_5": "(.insights.entities | length) <= 5",
          "important_phrases_max_5": "(.insights.important_phrases | length) <= 5",
          "important_words_max_5": "(.insights.important_words | length) <= 5",
          "entity_values_unique": "(.insights.entities | map(.value) | map(select(length > 0)) | unique | length) == (.insights.entities | map(.value) | map(select(length > 0)) | length)",
          "entity_types_present": "all(.insights.entities[]; .type != null and (.type | length) > 0)",
          "no_artlist_candidates": "all(.assets.candidates[]?; .provider != \"artlist\")",
          "no_internet_images_candidates": "all(.assets.candidates[]?; .provider != \"internet_images\")",
          "cache_extraction_not_bypassed": "(.cache.extraction != \"BYPASSED\")"
        }
      }
    },
    "no_provider_calls": "vidrush_provider_requests_total{provider=\"artlist\"} unchanged AND vidrush_provider_requests_total{provider=\"internet_images\"} unchanged",
    "persistence": "job persistito in SQLite e recuperabile via GET /api/jobs/{job_id}/full"
  }
}
