# PipelineGen — canonical environment variables
# Copy this file to .env and fill in real values before booting.
#
# The server refuses to start with placeholder tokens.
# Generate tokens with: openssl rand -hex 32
#
# Run `make preflight` before boot, `make doctor` after boot.

# ── Server ──────────────────────────────────────────────────────────
# Canonical port is 8000 (Operational Readiness PR, June 2026). See
# internal/platform/config/types.go `Server.Port` for the
# canonical source-of-truth. VELOX_BASE_URL is empty by default — fill it
# in for production deployments so remote-sidecar clients (image
# service,Flow sheets) can reach us back via webhooks.
# 0.0.0.0 binds all interfaces and makes the server reachable on the LAN.
# Use this only on a trusted private network; for public exposure always
# prefer a reverse-proxy with HTTPS and leave the bind on 127.0.0.1.
VELOX_HOST=0.0.0.0
VELOX_PORT=8000
VELOX_MASTER_URL=http://127.0.0.1:8000
VELOX_BASE_URL=

# ── Security ────────────────────────────────────────────────────────
VELOX_ENABLE_AUTH=true
VELOX_ADMIN_TOKEN=replace-with-a-long-random-token
VELOX_WORKER_TOKEN=replace-with-a-long-random-token
VELOX_DELIVERY_HMAC_SECRET=replace-with-at-least-32-random-bytes
# VELOX_DELIVERY_HMAC_SECRET_PREVIOUS=   # key-rotation: previous secret
# VELOX_DELIVERY_REPLAY_WINDOW_SECONDS=300
# VELOX_ALLOW_INSECURE_DEV=false         # disable HMAC; DEV ONLY
# VELOX_ALLOW_PLACEHOLDERS=false         # allow placeholder tokens; DEV ONLY
# VELOX_WEBHOOK_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────
# VELOX_RATE_LIMIT_ENABLED=true
# VELOX_RATE_LIMIT_REQUESTS=100

# ── CORS ────────────────────────────────────────────────────────────
# VELOX_CORS_ORIGINS=                    # comma-separated origins

# ── Timeouts ────────────────────────────────────────────────────────
# VELOX_READ_TIMEOUT=30s
# VELOX_WRITE_TIMEOUT=60s

# ── Storage ─────────────────────────────────────────────────────────
VELOX_DATA_DIR=./data
# VELOX_TEMP_DIR=tmp
# VELOX_CACHE_DIR=./data/cache
# VELOX_WORKSPACE_DIR=./data/workspace
# VELOX_EXPORT_DIR=./data/export
# VELOX_WORKFLOWS_DIR=./data/workflows
# VELOX_CLIP_TEXT_DIR=./data/clip_text

# ── Database paths ──────────────────────────────────────────────────
# VELOX_PRIMARY_DB_PATH=./data/media/media.db.sqlite
# VELOX_OBSERVABILITY_DB_PATH=./data/observability/api_requests.db.sqlite

# ── Observability retention ─────────────────────────────────────────
# VELOX_OBSERVABILITY_MAX_AGE_DAYS=7
# VELOX_OBSERVABILITY_MAX_SIZE_MB=1024

# ── Logging ─────────────────────────────────────────────────────────
# VELOX_LOG_LEVEL=info
# VELOX_LOG_FORMAT=json
# VELOX_LOG_FORCE_SYNC=false

# ── External tools ──────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
# yt-dlp path and JS runtime are CANONICAL from the systemd drop-in
# scripts/systemd/pipelinegen.service.d/youtube-dlp.conf (YTDLP_PATH points
# to scripts/yt-dlp-pipeline; YT_JS_RUNTIME_PATH=node). The values below are
# only the non-systemd fallback. start_server.sh re-applies the systemd
# values after sourcing .env, so this file cannot override them.
YTDLP_PATH=yt-dlp
YT_JS_RUNTIME_PATH=node

# ── Ollama (LLM) ────────────────────────────────────────────────────
OLLAMA_ADDR=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# VELOX_USE_NVIDIA_FOR_LLM=false
# VELOX_NVIDIA_LLM_MODEL=

# ── Concurrency ─────────────────────────────────────────────────────
# VELOX_CONCURRENT_VIDEO_EXTRACTS=2
# VELOX_CONCURRENT_SCRIPT_GENERATIONS=2
# VELOX_CONCURRENT_NVIDIA_GENERATIONS=10
# VELOX_CONCURRENT_OLLAMA_CALLS=1
# VELOX_CONCURRENT_CHANNEL_CHECKS=20
# VELOX_CONCURRENT_CLIP_INDEXING=10

# ── Google Drive ────────────────────────────────────────────────────
VELOX_CREDENTIALS_FILE=credentials.json
VELOX_TOKEN_FILE=token.json
# VELOX_DRIVE_MEDIA_ROOT=        # unified Drive root for all media; the per-domain *_ROOT below fall back here when empty
# VELOX_DRIVE_STOCK_ROOT=
# VELOX_DRIVE_CLIPS_ROOT=
# VELOX_DRIVE_VOICEOVER_ROOT=
# VELOX_DRIVE_ARTLIST_ROOT=
# VELOX_DRIVE_IMAGES_ROOT=
# VELOX_DRIVE_BOOKS_ROOT=
# VELOX_DRIVE_SCRIPTS_ROOT=
# VELOX_DRIVE_SCRIPTS_GENERATE=
# VELOX_DRIVE_VIDEO_AI_ROOT=
# VELOX_DRIVE_COPERTINE_ROOT=
# VELOX_DRIVE_SOUND_EFFECTS_ROOT=
# VELOX_DRIVE_AVATAR_AI_ROOT=
# VELOX_DRIVE_SHARED_WITH_EMAIL=

# ── Features (enable as needed) ─────────────────────────────────────
# VELOX_FEATURE_ARTLIST_ENABLED=false
# VELOX_FEATURE_YOUTUBE_ENABLED=false
# VELOX_FEATURE_DRIVE_ENABLED=false
# VELOX_FEATURE_IMAGES_ENABLED=false
# VELOX_FEATURE_SCRIPT_DOCS_ENABLED=false
# VELOX_FEATURE_SCRIPT_CLIPS_ENABLED=false
# VELOX_FEATURE_STOCK_PIPELINE_ENABLED=false
# VELOX_FEATURE_VOICEOVER_ENABLED=false
# VELOX_FEATURE_CATALOG_SCRIPT_VECTOR_SEARCH=false

# ── Artlist pipeline ───────────────────────────────────────────────
# Canonical Artlist scraper server URL. Must match
# external.artlist_scraper_server_url in config.yaml. The Node.js
# scraper (node-scraper/artlist_server.js) binds to 127.0.0.1:9123
# by default; override here for a remote scraper host.
# Required: yes (artlist_enabled=true in config.yaml requires a
# reachable scraper at this URL)
VELOX_ARTLIST_SCRAPER_SERVER_URL=http://127.0.0.1:9123
# Scraper total budget (Chromium cold-start + DOM scroll on artlist.com).
# Override at deployment. See docs/operations/stock-e2e-runbook.md §11.0.
SCROLL_TIMEOUT=120
# Scraper connect-budget (Chromium launch + first page navigation).
# Override at deployment. See docs/operations/stock-e2e-runbook.md §11.0.
SCRAPER_CONNECT_TIMEOUT_SECONDS=5
# Artlist acquisition mode override. Must match
# external.artlist_acquisition_mode in config.yaml.
# Values: "authorized_api" (default) | "manual_import"
# ARTLIST_ACQUISITION_MODE=authorized_api
# Artlist per-account daily download cap. Must match
# external.artlist_daily_download_limit in config.yaml. 0 disables
# automatic downloads.
# ARTLIST_DAILY_DOWNLOAD_LIMIT=10

# ── Background jobs ─────────────────────────────────────────────────
# VELOX_ENABLE_BACKGROUND_JOBS=true
# VELOX_ENABLE_CHANNEL_MONITOR=true
# VELOX_ENABLE_TEST_JOB_HANDLERS=false
# VELOX_CATALOG_SYNC_INTERVAL=6h

# ── Outbox ──────────────────────────────────────────────────────────
# VELOX_OUTBOX_BATCH_SIZE=50
# VELOX_OUTBOX_MAX_ATTEMPTS=5
# VELOX_OUTBOX_POLL_MS=5000
# VELOX_OUTBOX_PROCESS_TIMEOUT_S=120
# VELOX_OUTBOX_RECLAIM_INTERVAL_S=300
# VELOX_OUTBOX_STALE_THRESHOLD_S=600
# VELOX_OUTBOX_WORKERS=2

# ── Scripts ─────────────────────────────────────────────────────────
# VELOX_SCRIPTS_CHANNEL_ID=
# VELOX_SCRIPTS_BATCH_CHANNEL_ID=
# VELOX_SCRIPTS_DEFAULT_LANGUAGE=it
# VELOX_SCRIPTS_DEFAULT_TONE=documentary
# VELOX_SCRIPTS_DEFAULT_DURATION=7
# VELOX_SCRIPTS_MAX_TOPIC_CHARS=500
# VELOX_SCRIPTS_MAX_GUIDELINES_CHARS=2000
# VELOX_SCRIPTS_MAX_INSIGHT_ENTITIES=12
# VELOX_SCRIPTS_MAX_PHRASE_SUGGESTIONS=8
# VELOX_SCRIPTS_MIN_WORD_FLOOR=300
# VELOX_SCRIPTS_CLIP_SEARCH_MIN_SCORE=0.3
# VELOX_SCRIPTS_BATCH_WEBSEARCH_CONCURRENCY=4
# VELOX_SCRIPTS_BATCH_CHAPTER_CONCURRENCY=3
# VELOX_SCRIPTS_GENERATE_TIMEOUT=900s
# VELOX_SCRIPTS_SAVE_TIMEOUT=30s
# VELOX_SCRIPTS_BATCH_TIMEOUT=3600s

# ── Qdrant ──────────────────────────────────────────────────────────
# VELOX_QDRANT_COLLECTION_ALIAS=media_assets
# VELOX_QDRANT_COLLECTION_VERSION=
# VELOX_QDRANT_DISABLE_ALIAS=false
# VELOX_QDRANT_RETRY_ATTEMPTS=3
# VELOX_QDRANT_RETRY_INITIAL_WAIT_MS=200
# VELOX_QDRANT_RETRY_MAX_WAIT_MS=5000

# ── Download security ───────────────────────────────────────────────
# VELOX_ALLOWED_DOWNLOAD_HOSTS=youtube.com,www.youtube.com,youtu.be,artlist.com,www.artlist.com,artlist.io,cdn.artlist.io

# ── Google Accounting ───────────────────────────────────────────────
# VELOX_GOOGLE_ACCOUNTING_ENABLED=false
# VELOX_GOOGLE_ACCOUNTING_URL=http://localhost:8000
# VELOX_GOOGLE_ACCOUNTING_DOWNLOAD_DIR=./data/google_vids
# VELOX_GOOGLE_ACCOUNTING_VIDS_PROJECT_ID=

# ── YouTube ─────────────────────────────────────────────────────────
# VELOX_YOUTUBE_EXTRACT_TIMEOUT=300s

# ── Paths ───────────────────────────────────────────────────────────
# VELOX_PYTHON_SCRIPTS_DIR=scripts
# VELOX_NODE_SCRAPER_DIR=node-scraper

# ── Retention ───────────────────────────────────────────────────────
# VELOX_RETENTION_DAYS=90
